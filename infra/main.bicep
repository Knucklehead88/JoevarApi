// Joevar on Azure: the API (App Service), its PostgreSQL database and the website (Static Web Apps).
// Deploy with infra/deploy.sh, which passes the secrets; re-running it is safe and brings everything back in line.

@description('Region for the API and the database. Central US (Iowa) is close to Chicago, and it is the only nearby region where this Free Trial subscription has App Service quota.')
param location string = 'centralus'

@description('Static Web Apps only run in a few regions; the site is served worldwide from its CDN either way.')
param webLocation string = 'centralus'

@description('Names must be unique across Azure; change them if a deployment says one is taken.')
param apiName string = 'joevar-api'
param webName string = 'joevar-web'
param databaseServerName string = 'joevar-pg'

param databaseAdminLogin string = 'joevaradmin'

@description('F1 is free (sleeps when idle, 60 CPU minutes a day, no custom domain); B1 (~$13/month) stays awake and allows api.joevar.com.')
@allowed(['F1', 'B1'])
param apiPlanSku string = 'F1'

@secure()
@description('Generated by deploy.sh on every run; the API\'s connection string is updated to match.')
param databaseAdminPassword string

@secure()
@description('API settings from the user secrets (Twilio, Email, Google), as { "Twilio__AccountSid": "..." }.')
param apiSecrets object = {}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: databaseServerName
  location: location
  sku: {
    name: 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    version: '17'
    administratorLogin: databaseAdminLogin
    administratorLoginPassword: databaseAdminPassword
    // 32 GB and B1ms are inside the free account's 12 free months; growing past 32 GB would be charged.
    storage: {
      storageSizeGB: 32
      autoGrow: 'Disabled'
    }
    backup: {
      backupRetentionDays: 7
      geoRedundantBackup: 'Disabled'
    }
    highAvailability: {
      mode: 'Disabled'
    }
    network: {
      publicNetworkAccess: 'Enabled'
    }
  }
}

resource joevarDatabase 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: database
  name: 'joevar'
  properties: {
    charset: 'UTF8'
    collation: 'en_US.utf8'
  }
}

// 0.0.0.0 means "Azure services", i.e. the API. Nothing else on the internet can connect.
resource allowAzureServices 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: database
  name: 'AllowAzureServices'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource web 'Microsoft.Web/staticSites@2024-04-01' = {
  name: webName
  location: webLocation
  sku: {
    name: 'Free'
    tier: 'Free'
  }
  properties: {}
}

resource plan 'Microsoft.Web/serverfarms@2024-04-01' = {
  name: '${apiName}-plan'
  location: location
  kind: 'linux'
  sku: {
    name: apiPlanSku
  }
  properties: {
    reserved: true
  }
}

var webOrigin = 'https://${web.properties.defaultHostname}'

// Settings that aren't secret. Nested keys use "__" (Cors__AllowedOrigins__0 is Cors:AllowedOrigins:0).
var apiSettings = {
  ASPNETCORE_ENVIRONMENT: 'Production'
  // App Service terminates HTTPS in front of the app: trust its X-Forwarded-* headers so the client IP (rate limits)
  // and the https scheme are right.
  ASPNETCORE_FORWARDEDHEADERS_ENABLED: 'true'
  // The new site, and the old Shopify store whose SMS opt-in form still posts here.
  Cors__AllowedOrigins__0: webOrigin
  Cors__AllowedOrigins__1: 'https://joevar.com'
  Cors__AllowedOrigins__2: 'https://www.joevar.com'
  // Passkeys need the site and the API on one parent domain (joevar.com), so they only work after the custom domain.
  Passkeys__ServerDomain: web.properties.defaultHostname
}

resource api 'Microsoft.Web/sites@2024-04-01' = {
  name: apiName
  location: location
  kind: 'app,linux'
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|10.0'
      // Not available on F1: the free API sleeps after about 20 idle minutes and wakes on the next request.
      alwaysOn: apiPlanSku != 'F1'
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      http20Enabled: true
    }
  }
}

// All app settings, replaced as a whole on every deployment (so keep them here or in deploy.sh, not in the portal).
resource apiAppSettings 'Microsoft.Web/sites/config@2024-04-01' = {
  parent: api
  name: 'appsettings'
  properties: union(apiSettings, apiSecrets)
}

// "Custom" connection strings reach .NET as ConnectionStrings:Default.
resource apiConnectionStrings 'Microsoft.Web/sites/config@2024-04-01' = {
  parent: api
  name: 'connectionstrings'
  properties: {
    Default: {
      type: 'Custom'
      value: 'Host=${database.properties.fullyQualifiedDomainName};Database=${joevarDatabase.name};Username=${databaseAdminLogin};Password=${databaseAdminPassword};Ssl Mode=Require'
    }
  }
}

// GitHub Actions deploys with the app's publish profile, which needs basic publishing credentials.
resource scmCredentials 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2024-04-01' = {
  parent: api
  name: 'scm'
  properties: {
    allow: true
  }
}

output apiUrl string = 'https://${api.properties.defaultHostName}'
output webUrl string = webOrigin
